    "cacheReservationBytes": 67108864,
    "sharedContinuousNodes": 65536,
    "coverageRoundoff": 1e-06
  },
  "work": {
    "coverage": "4P+4S*H*(1+ceil(log2(max(S,1))))",
    "paint": "P*(1+ceil(log2(N)))",
    "nonzeroExpansion": "24P",
    "nonzeroFeather": "2P*(2*ceil(3*featherPx*rho)+1)",
    "sampleCombine": "5P_owner_per_mask",
    "multiplySource": "4P_owner_once_per_owning_sample",
    "scope": "all_occurrences_masks_actual_shutter_samples_per_output_frame",
    "checkedArithmetic": true
  },
  "memory": {
    "currentPixelLineScratch": "64P+16(W+H)",
    "additiveKernelBytes": "4K where K=2*ceil(3*featherPx*rho)+1 for_nonzero_feather",
    "ownerAccumulator": "4P_owner",
    "retainedContours": "64*SUM(S_all_concurrently_retained_facts)",
    "additionalRetainedMetadata": "checked_fact_headers_ID_UTF8_Paint_gradient_heap_Vec_descriptors_capacities_including_S0_no_grid",
