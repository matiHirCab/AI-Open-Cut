      "property",
      "target"
    ],
    "missingIdError": "ITEM_NOT_FOUND",
    "invalidError": "INVALID_ARGUMENT"
  },
  "applicability": {
    "path_points": "exact_static_command_coordinate_order_and_count_max4096",
    "paint_color": "solid_paint_only",
    "gradient_stops": "linear_or_radial_matching_static_stop_count2_to32",
    "transform_position": "static_unit_pixels_max_abs1000000_or_normalized_max_abs100",
    "immutable": [
      "source",
      "path_topology",
      "fillRule",
      "paint_type",
      "gradient_geometry",
      "position_unit",
      "channel",
      "inverted",
      "operation",
      "id"
    ]
  },
  "algorithm": {
    "order": [
      "geometric_fill",
      "signed_expansion",
      "original_coordinate_paint_channel",
      "gaussian_feather",
      "mask_affine_opacity",
      "inversion",
      "ordered_combination",
      "source_rgba_multiplication"
    ],
    "fill": "tiny_skia_antialiased_alpha_byte_div255",
    "density": "max(1,ownerDensity*maximum_singular_value(mask_linear))",
    "ownerBasis": "post_crop_clip_pre_effect_top_left_zero",
    "ownerLogicalExtent": "W/ownerDensity,H/ownerDensity",
    "ownerPixelCenter": "((x+0.5)/ownerDensity,(y+0.5)/ownerDensity)",
    "anchor": "sampled_unexpanded_analytic_path_bounds",
    "paddingGridPixels": "ceil(abs(expansionPx)*rho)+ceil(3*featherPx*rho)+2",
    "distance": {
      "algorithm": "two_separable_exact_squared_euclidean_lower_envelopes",
      "complexity": "O(P)",
      "insideSeeds": "C>0",
      "outsideSeeds": "C<1",
      "partial": "d=C-0.5",
      "full": "d=sqrt(D_O)-0.5",
      "empty": "d=0.5-sqrt(D_I)",
      "expanded": "clamp(0.5+d+expansionPx*rho,0,1)",
      "zeroExpansion": "exact_bypass",
      "noInsideSeeds": "zero_coverage",
      "tie": "lower_index",
      "noSeed": "absence_not_float_infinity"
    },
    "paintChannels": {
      "alpha": "C_e*A",
      "luma": "C_e*(0.2126*R+0.7152*G+0.0722*B)",
      "colorSpace": "floating_premultiplied_linear",
      "coordinates": "original_path_coordinates_no_gradient_stretch"
    },
    "feather": {
      "sigma": "featherPx*rho",
      "tapRadius": "ceil(3*sigma)",
      "kernel": "normalized_exp(-0.5*(k/sigma)^2)",
      "passes": [
        "horizontal_left_to_right",
        "vertical_top_to_bottom"
      ],
      "outside": "transparent_no_edge_renormalization",
      "zeroSigma": "exact_bypass"
    },
    "sampling": "inverse_affine_bilinear_half_pixel_transparent_extension",
    "opacity": "multiply_once_before_inversion",
    "inversion": "1-B_within_owner_domain",
    "seeds": {
      "add": 0,
      "exclude": 0,
      "subtract": 1,
      "intersect": 1
    },
    "combination": {
      "add": "A+B-A*B",
      "subtract": "A*(1-B)",
      "intersect": "A*B",
      "exclude": "A+B-2*A*B"
    },
    "source": "multiply_all_four_premultiplied_components_once_before_effects",
    "emptyStack": "exact_identity_bypass"
  },
  "limits": {
    "maxDimension": 16384,
    "maxPixels": 16777216,
    "maxExpandedOccurrences": 4096,
    "maxSegmentsPerMask": 65536,
    "maxSceneSegments": 1048576,
    "contourToleranceGridPixels": 0.25,
    "maxRasterConversionDisplacement": 0.25,
    "maxMaskWorkUnitsPerOutputFrame": 268435456,
