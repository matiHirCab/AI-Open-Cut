  "clip": {
    "record": {
      "type": "composition_bounds"
    },
    "eligible": [
      "group",
      "component_instance"
    ],
    "stored": "optional_non_null",
    "edit": "omission_preserves_null_clears",
    "basis": "group_containing_composition_or_instance_definition",
    "stage": "half_open_pixel_center_clip_before_owner_effects"
  },
  "semantics": {
    "screenFlash": {
      "window": "[startMs,startMs+durationMs)",
      "strength": "intensity*color.a*(1-(ownerLocalTime-startMs)/durationMs); zero outside",
      "equation": "p[c]+(A-p[c])*linear(color[c])*strength",
      "alpha": "unchanged; A0 implies RGB0",
      "clock": "canonical original-owner SampleTime; compare/progress before float conversion"
    },
    "particles": {
      "hash": "mix32(seed XOR wrapping32((index+1)*0x9e3779b9) XOR wrapping32((lane+1)*0x85ebca6b))",
      "mix32": [
        "xor_right_16",
        "wrapping_multiply_0x7feb352d",
        "xor_right_15",
        "wrapping_multiply_0x846ca68b",
        "xor_right_16"
      ],
      "unitDenominator": 4294967296,
      "domain": "fixed_original_unstroked_leaf_or_aggregate_composition_bounds",
      "zeroDomain": "identity_before_modulo; admission_retained",
      "position": "x=originX+U0*width; y=originY+(U1*height+speed*phase/1000)%height",
      "phase": "((ownerLocalTime%lifetimeMs)+U2*lifetimeMs)%lifetimeMs",
      "integerClock": "reduce_integer_or_Split_whole_modulo_before_f64_conversion",
      "coverage": "4x4 raster samples at (a+.5)/4; closed squared circle",
      "density": "centers subtract signed raster local origin then multiply certified density d; radius=radiusPx*d; aggregates d=1",
      "box": "floor(center-rasterRadius)-1 .. ceil(center+rasterRadius)+1 exclusive; width<=ceil(2*rasterRadius)+3",
      "composition": "index_ascending_premultiplied_linear_source_over",
      "identities": [
        "count0",
        "radius0",
        "color_alpha0"
      ],
      "support": "fixed_domain_expanded_radiusPx; ceil(radiusPx*d) raster padding"
    },
    "aggregate": {
      "activation": "explicit_clip_or_nonempty_effects_only",
      "children": "completed_relative_local_planes_then_canonical_blend_into_transparent_black",
      "order": "owner_contiguous_block; child_local_z_cannot_escape",
      "stage": "child_source_masks_effects_relative_affine_world_matte_relative_gain_own_shutter_then_blend; owner_clip_effects_outward_affine_gain_once",
      "anchor": "fixed_composition_basis_independent_of_signed_union",
      "temporalBoundary": "owner_uncontrolled_outward_factors_stop_before_immediate_enclosing_controlled_owner_and_freeze_at_requested_output_sample; top_level_through_root",
      "provider": "separate_leaf_full_world_ancestry_gain_and_shutter_excluding_ancestor_aggregate_clip_effects_destinationblend",
      "query": "certified_origin_axes_dimensions_map_local_centers_to_world; direct_source_sampling_offcanvas; exact_frame_in_memo_key",
      "matteOnly": "exclude_direct_aggregate_source_and_halo_keep_private_coverage_audio"
    },
    "channels": "no_new_properties; aggregate_effect_targets_remain_unsupported"
  },
  "limits": {
    "maxEffectsPerItem": 16,
    "maxEffectIdUtf8Bytes": 128,
    "maxExpandedOccurrencesIncludingAggregatesAndQueries": 4096,
    "maxSurfaceDimension": 16384,
    "maxSurfacePixels": 16777216,
    "maxEffectWork": 268435456,
    "maxShutterWork": 268435456,
    "maxMatteWork": 268435456,
    "maxProviderRequests": 4096,
    "peakLiveBytes": 1073741824,
    "cacheReserveBytes": 67108864,
    "flashWork": "3P",
    "particleWork": "4P+count*20*(ceil(2*radiusPx*d)+3)^2"
  },
