R2_BUCKET=opencut-assets

# OpenCut Agent Bridge (use local placeholder directories only)
# Every documented relative path is resolved from this absolute root.
# Defaults once at startup to the bridge working directory.
# OPENCUT_CONFIG_ROOT=C:/absolute/path/to/AI-Open-Cut
OPENCUT_PROJECTS_DIR=./local-data/projects
OPENCUT_ALLOWED_MEDIA_DIRS=./local-data/media
OPENCUT_EXPORTS_DIR=./local-data/exports
# OPENCUT_FFMPEG_PATH=ffmpeg
# OPENCUT_FFPROBE_PATH=ffprobe
# OPENCUT_DEFAULT_FONT_PATH=./local-data/fonts/default.ttf
# OPENCUT_HEADLESS_PATH=./target/release/opencut-headless
# OPENCUT_LOG_LEVEL=info

# Local Kokoro TTS (run apps/kokoro-tts/setup.ps1 first)
# OPENCUT_SPEECH_PROVIDER=kokoro
# OPENCUT_KOKORO_PYTHON=./local-data/kokoro/venv/Scripts/python.exe
# OPENCUT_KOKORO_MODEL_DIR=./local-data/kokoro/model
# OPENCUT_TTS_WORK_DIR=./local-data/kokoro/work
# Additional provider-neutral generated-media roots, separated by the platform path separator
# OPENCUT_GENERATED_MEDIA_DIRS=./local-data/generated
# OPENCUT_HEADLESS_REQUEST_TIMEOUT_MS=600000
# OPENCUT_TTS_CONTROL_TIMEOUT_MS=10000
# OPENCUT_TTS_SYNTHESIS_TIMEOUT_MS=300000
# OPENCUT_TTS_MAX_QUEUED=8
# OPENCUT_JOB_TTL_MS=3600000
# OPENCUT_JOB_MAX_COUNT=1000
# OPENCUT_GENERATED_ARTIFACT_TTL_MS=600000

# Local faster-whisper transcription (run apps/faster-whisper/setup.ps1 first)
# OPENCUT_TRANSCRIPTION_PYTHON=./local-data/transcription/venv/Scripts/python.exe
# OPENCUT_TRANSCRIPTION_WORKER=./apps/faster-whisper/worker.py
# OPENCUT_TRANSCRIPTION_MODEL_DIR=./local-data/transcription/model
# OPENCUT_TRANSCRIPTION_MODEL=small
# OPENCUT_TRANSCRIPTION_CONTROL_TIMEOUT_MS=10000
# OPENCUT_TRANSCRIPTION_TIMEOUT_MS=900000
# OPENCUT_TRANSCRIPTION_MAX_QUEUED=4

# Streamable HTTP (STDIO is the default)
# OPENCUT_TRANSPORT=http
# OPENCUT_HTTP_HOST=127.0.0.1
# OPENCUT_HTTP_PORT=3002
# Required for non-loopback binds
# OPENCUT_HTTP_AUTH_TOKEN=replace-with-a-long-random-token
# Comma-separated exact origins; wildcard CORS is never enabled
# OPENCUT_HTTP_ALLOWED_ORIGINS=http://127.0.0.1:3000
# OPENCUT_HTTP_MAX_BODY_BYTES=1048576
