{
  "status": "DRAFT independent planning oracles; no live validators used; not implementation approval",
  "version": 1,
  "constants": {
    "maxRecords": 64,
    "maxIntentBytes": 4096,
    "maxRecordBytes": 8192,
    "maxCatalogBytes": 1048576,
    "maxOwnedMetadataBytes": 2097188,
    "retentionMs": 604800000
  },
  "input": {
    "version": 1,
    "requestId": "00000000-0000-4000-8000-000000000001",
    "intent": {
      "kind": "preview_frame",
      "request": {
        "projectId": "project-original",
        "expectedRevision": 4,
        "timeMs": 250
      }
    }
  },
  "cases": [
    {
      "name": "initial queued admission",
      "expected": {
        "created": true,
        "producerCalls": 0,
        "record": {
          "version": 1,
          "requestId": "00000000-0000-4000-8000-000000000001",
          "intent": {
            "kind": "preview_frame",
            "request": {
              "projectId": "project-original",
              "expectedRevision": 4,
              "timeMs": 250
            }
          },
          "createdAtMs": 1000,
          "updatedAtMs": 1000,
          "expiresAtMs": 604801000,
          "confirmedState": "queued",
          "state": "queued",
          "uncertainty": null,
          "outcome": null
        }
      }
    },
    {
      "name": "canonical duplicate admission",
      "inputChange": "reorder object keys only",
      "expected": {
        "created": false,
        "producerCalls": 0,
        "record": {
          "version": 1,
          "requestId": "00000000-0000-4000-8000-000000000001",
          "intent": {
            "kind": "preview_frame",
            "request": {
              "projectId": "project-original",
              "expectedRevision": 4,
              "timeMs": 250
            }
          },
          "createdAtMs": 1000,
          "updatedAtMs": 1000,
          "expiresAtMs": 604801000,
          "confirmedState": "queued",
          "state": "queued",
          "uncertainty": null,
          "outcome": null
        }
      }
    },
    {
      "name": "conflicting retained identity",
      "inputChange": {
        "intent.request.timeMs": 251
      },
      "expected": {
        "errorCode": "VALIDATION_FAILED",
        "producerCalls": 0,
        "unchangedStoredRecord": true
      }
    },
    {
      "name": "explicit start and concurrent identical start",
      "clockMs": 1100,
      "expected": {
        "producerCalls": 1,
        "state": "running",
        "confirmedState": "running",
        "updatedAtMs": 1100,
        "uncertainty": null,
        "jobHandle": "same live process-only handle"
      }
    },
    {
      "name": "known native PNG before local retention failure",
      "clockMs": 1200,
      "nativeResult": {
        "format": "png",
        "sizeBytes": 123
      },
      "localJobStatus": "failed",
      "expected": {
        "state": "completed",
        "confirmedState": "completed",
        "outcome": {
          "kind": "rendered",
          "format": "png",
          "sizeBytes": 123
        },
        "persistedOpaqueHandles": 0
      }
    },
    {
      "name": "restart queued",
      "expected": {
        "producerCalls": 0,
        "state": "queued",
        "confirmedState": "queued",
        "uncertainty": null,
        "oldJobAdoptions": 0
      }
    },
    {
      "name": "restart running",
      "expected": {
        "producerCalls": 0,
        "state": "uncertain",
        "confirmedState": "running",
        "uncertainty": "previous_runtime",
        "oldJobAdoptions": 0
      }
    },
    {
      "name": "lost terminal confirmation",
      "nativeResult": {
        "format": "png",
        "sizeBytes": 123
      },
      "safeExactReadback": false,
      "expected": {
        "state": "uncertain",
        "confirmedState": "running",
        "uncertainty": "metadata_unconfirmed",
        "outcome": null,
        "newProducers": 0,
        "guardsRetained": true
      }
    },
    {
      "name": "terminal rename acknowledgement loss with exact whole readback",
      "safeExactReadback": true,
      "expected": {
        "state": "completed",
        "confirmedState": "completed",
        "uncertainty": null,
        "producerReplays": 0
      }
    },
    {
      "name": "same-record-only readback is insufficient",
      "safeRecordMatch": true,
      "safeWholeCatalogMatch": false,
      "expected": {
        "state": "uncertain",
        "uncertainty": "metadata_unconfirmed",
        "guardsRetained": true
      }
    },
    {
      "name": "confirmed native error",
      "error": {
        "origin": "validated core terminal response",
        "code": "REVISION_CONFLICT",
        "retryable": true
      },
      "expected": {
        "state": "failed",
        "outcome": {
          "kind": "error",
          "code": "REVISION_CONFLICT",
          "retryable": true
        }
      }
    },
    {
      "name": "unconfirmed transport error with same code",
      "error": {
        "origin": "local transport",
        "code": "REVISION_CONFLICT",
        "retryable": true
      },
      "expected": {
        "state": "uncertain",
        "uncertainty": "dispatch_unconfirmed",
        "outcome": null
      }
    },
    {
      "name": "pre-entry immediate cancellation",
      "taskEntered": false,
      "expected": {
        "state": "cancelled",
        "outcome": {
          "kind": "cancelled"
        },
        "producerCalls": 0
      }
    },
    {
      "name": "post-entry signal abort without core confirmation",
      "taskEntered": true,
      "expected": {
        "state": "uncertain",
        "uncertainty": "dispatch_unconfirmed",
        "outcome": null
      }
    },
    {
      "name": "exact retention boundary for inactive queued",
      "clockMs": 604801000,
      "expected": {
        "get": null,
        "expiredCount": 1,
        "absenceMeaning": "unknown",
        "producerCalls": 0
      }
    },
    {
      "name": "active producer remains charged past retention",
      "clockMs": 604801001,
      "liveOwnedProducer": true,
      "expected": {
        "recordCharged": true,
        "evictedForCapacity": false
      }
    },
    {
      "name": "clock rollback",
      "clockMs": 900,
      "expected": {
        "expiredCount": 0,
        "nextUpdatedAtMsAtLeast": 1000
      }
    },
    {
      "name": "unsafe or future catalog",
      "expected": {
        "errorCode": "DEPENDENCY_UNAVAILABLE",
        "producerCalls": 0,
        "catalogRewrites": 0
      }
    },
    {
      "name": "first safe empty store read",
      "expected": {
        "requests": [],
        "storage": {
          "readable": true,
          "writable": false,
          "reason": "not_initialized"
        },
        "absenceMeaning": "unknown",
        "filesystemCreates": 0
      }
    },
    {
      "name": "missing catalog plus predecessor stage",
      "expected": {
        "errorCode": "DEPENDENCY_UNAVAILABLE",
        "producerCalls": 0,
        "filesystemDeletes": 0
      }
    },
    {
      "name": "preparation rejects before running claim",
      "taskEntered": false,
      "expected": {
        "state": "failed",
        "producerCalls": 0,
        "storedRunningClaims": 0
      }
    },
    {
      "name": "startTask rejects before entering wrapper",
      "taskEntered": false,
      "expected": {
        "state": "failed",
        "producerCalls": 0
      }
    },
    {
      "name": "wrapper throws after captured native success",
      "nativeResultCaptured": {
        "format": "png",
        "sizeBytes": 123
      },
      "expected": {
        "state": "completed",
        "outcome": {
          "kind": "rendered",
          "format": "png",
          "sizeBytes": 123
        }
      }
    },
    {
      "name": "two producers settle during first terminal debt",
      "pendingRequestCount": 2,
      "safeCloseMerge": true,
      "expected": {
        "pendingOverlaysBeforeClose": 2,
        "nativeReplays": 0,
        "metadataRecoveryTransactions": 1,
        "retainedConfirmedOutcomes": 2
      }
    },
    {
      "name": "two producers settle and close merge unconfirmed",
      "pendingRequestCount": 2,
      "safeCloseMerge": false,
      "expected": {
        "pendingOverlaysAfterClose": 2,
        "nativeReplays": 0,
        "metadataRecoveryTransactions": 1,
        "guardsRetained": true
      }
    },
    {
      "name": "same valid catalog copied to another configured root",
      "rootBindingMatches": false,
      "expected": {
        "errorCode": "DEPENDENCY_UNAVAILABLE",
        "producerCalls": 0,
        "filesystemDeletes": 0
      }
    },
    {
      "name": "expired live owned producer remains visible",
      "liveOwnedProducer": true,
      "clockMs": 604801001,
      "expected": {
        "getIsNull": false,
        "listed": true,
        "recordCharged": true,
        "expiredCount": 0
      }
    },
    {
      "name": "oversized or invalid UTF8 catalog before JSON parse",
      "expected": {
        "errorCode": "DEPENDENCY_UNAVAILABLE",
        "producerCalls": 0,
        "parseAttempted": false
      }
    },
    {
      "name": "identical retained admission after project changed or deleted",
      "projectExists": false,
      "expected": {
        "created": false,
        "coreReadCalls": 0,
        "producerCalls": 0,
        "recordUnchanged": true
      }
    },
    {
      "name": "conflicting retained admission before core preflight",
      "projectExists": false,
      "expected": {
        "errorCode": "VALIDATION_FAILED",
        "coreReadCalls": 0,
        "producerCalls": 0
      }
    },
    {
      "name": "start retained terminal running or uncertain after project deletion",
      "projectExists": false,
      "states": [
        "completed",
        "failed",
        "cancelled",
        "running",
        "uncertain"
      ],
      "expected": {
        "recordUnchanged": true,
        "coreReadCalls": 0,
        "producerCalls": 0,
        "writeGuardAcquisitions": 0
      }
    },
    {
      "name": "current cancellation is pre-entry job cancellation not native JobCancelled",
      "nativeCoreContractAdds": 0,
      "expected": {
        "preEntryState": "cancelled",
        "postEntryAbortState": "uncertain"
      }
    },
    {
      "name": "native result has unexpected MIME despite requested format",
      "expected": {
        "state": "uncertain",
        "uncertainty": "dispatch_unconfirmed",
        "inventedRequestedFormat": false
      }
    }
  ],
  "faultPoints": [
    "before_stage_create",
    "partial_stage_write",
    "after_stage_fsync",
    "before_catalog_rename",
    "after_catalog_rename_before_ack",
    "whole_catalog_readback_failure",
    "path_identity_replacement",
    "terminal_metadata_write_after_native_publication"
  ],
  "compatibility": [
    "disabled configuration performs no durable filesystem operations",
    "existing job schemas/errors/cancellation/retention retain their meanings",
    "old tokens and jobs are never persisted or adopted",
    "existing authentication and private-root isolation remain unchanged"
